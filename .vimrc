" Syntax highlighting
syntax on

" Enable file type detection and language-dependent indenting
filetype plugin indent on

" Set line numbers
set number

" Set tab width to 4 spaces
set tabstop=4
set shiftwidth=4
set expandtab

" Enable auto-indentation
set autoindent

" Disable bell sound
set visualbell

" Show current position
set ruler

" Highlight search results
set hlsearch
